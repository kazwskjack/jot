# Copy to .env; keep .env, databases and token files outside Git.
# These are the existing gateway's defaults, with neutral deployment paths.
GENERAL_AGENT_HOST=127.0.0.1
GENERAL_AGENT_PORT=18831
GENERAL_AGENT_DB=/var/lib/jot/jot.db
GENERAL_AGENT_FILE_ROOT=/var/lib/jot/jot-files
GENERAL_AGENT_WORKSPACES=jot
GENERAL_AGENT_ALLOWED_ORIGINS=http://localhost:3030
# Generate independent random secrets; blank values intentionally fail startup.
GENERAL_AGENT_CSRF_TOKEN=
GENERAL_AGENT_INTERNAL_CHANNEL_TOKEN=
# Build creates an original template; point both processes at the same catalog.
GENERAL_AGENT_TEMPLATE_ROOT=/opt/jot/packages/gateway/dist/file-engine/templates
GENERAL_AGENT_FILE_ENGINE_TEMPLATE_ROOT=/opt/jot/packages/gateway/dist/file-engine/templates

# DSH/Cordis host and this adapter plugin must already be configured.
GENERAL_AGENT_SESSION_ADAPTER_URL=http://127.0.0.1:18841
GENERAL_AGENT_SESSION_ADAPTER_TOKEN_FILE=/etc/jot/session-adapter.token
GENERAL_AGENT_HARNESS_CWD=/opt/jot/workspace
GENERAL_AGENT_DSH_AGENT_PRESET=jot-general
GENERAL_AGENT_DSH_SESSION_PREFIX=jot-ugs1
# Ordinary human Goal resume: default off. Requires the matching trusted Host
# option, complete original queue-consumer upgrade and recovery/deployment gates.
# A configured Host readiness response is not a consumer-pool rollout audit.
GENERAL_AGENT_CONVERSATION_GOAL_RESUME_ENABLED=false
GENERAL_AGENT_WORKER_CONCURRENCY=1
# Background tasks share this limit with foreground conversations.
# Keep 1 for basic deployments. A lead plus one delegated member requires 3;
# a lead plus two active members requires 4 (one slot reserved for foreground).
# Increasing this does not enable delegation: each task needs an explicit grant.
GENERAL_AGENT_WORKER_POLL_MS=1000
GENERAL_AGENT_WORKER_LEASE_MS=900000

# Optional native browser/batch bridge. Not a browser pool setting.
GENERAL_AGENT_LEAF_BRIDGE_BASE_URL=http://127.0.0.1:18792
# Optional integration for context staging; blank disables the runtime client.
GENERAL_AGENT_RUNTIME_BASE_URL=
GENERAL_AGENT_RUNTIME_SECRET_FILE=

# File worker: Python + pypdf; office edits additionally need LibreOffice/UNO.
GENERAL_AGENT_FILE_ENGINE_PYTHON=/usr/bin/python3
GENERAL_AGENT_FILE_ENGINE_SCRIPT=/opt/jot/packages/gateway/dist/file-engine/worker.py
GENERAL_AGENT_FILE_ENGINE_TIMEOUT_MS=180000
GENERAL_AGENT_LIBREOFFICE=/usr/bin/libreoffice

# Voice stays disabled until DSH speechController and provider are ready.
GENERAL_AGENT_VOICE_ENABLED=false
GENERAL_AGENT_VOICE_ADAPTER_URL=http://127.0.0.1:18841
GENERAL_AGENT_VOICE_ADAPTER_TOKEN_FILE=/etc/jot/session-adapter.token

# Optional display suggestions, independent of task execution permissions.
JOT_EMOTION_PROVIDER=
OPENJEV_API_KEY=
JOT_EMOTION_LAYA_URL=
JOT_EMOTION_LAYA_TOKEN=

# Delivery worker transport. Email verification has a separate API switch;
# task details include the email form; live delivery acceptance is still pending.
# Default remains wecom. Use email or wecom,email only with server-owned grants.
GENERAL_AGENT_DELIVERY_CHANNELS=wecom
# Separate authenticated mailbox-verification API switch. Disabled by default.
GENERAL_AGENT_EMAIL_BINDINGS_ENABLED=false
GENERAL_AGENT_SMTP_HOST=
GENERAL_AGENT_SMTP_PORT=465
GENERAL_AGENT_SMTP_USER=
GENERAL_AGENT_SMTP_PASSWORD_FILE=
GENERAL_AGENT_SMTP_FROM=

# Reviewed/bounded reply host dispatch is experimental; public execution remains disabled.
# Requires workbench execution readiness. Keep off until deployment acceptance.
GENERAL_AGENT_TASK_REPLY_EXECUTION=0
# Optional host-only compatible judge config file. Blank disables model judging.
# Never place the provider key or private configuration in the public repository.
GENERAL_AGENT_TASK_REPLY_JUDGE_FILE=

# Optional local cold-notification maintenance in the existing worker loop.
# Private archive root is required when enabled. Does not delete identities/files.
GENERAL_AGENT_NOTIFICATION_ARCHIVE_ENABLED=0
GENERAL_AGENT_NOTIFICATION_ARCHIVE_ROOT=
GENERAL_AGENT_NOTIFICATION_ARCHIVE_RETENTION_DAYS=90
GENERAL_AGENT_NOTIFICATION_ARCHIVE_BATCH_SIZE=10

# Opt-in original ordinary-run recovery; requires the audited compatible Host.
GENERAL_AGENT_ORDINARY_INPUT_RECOVERY_ENABLED=false
# Chat is default-off and also requires verified host mode readiness and the
# independent jot-chat preset. The API and Worker must load the same setting.
# This flag alone does not provide the unfinished Chat preset/tool composition.
GENERAL_AGENT_CHAT_ENABLED=false
# Best-effort post-publication Chat maintenance, independently opt-in. Requires
# Chat/recovery/steering, a checkpoint-text-v2 source and the matching Host's
# ordinaryChatCompactionAuto/Recovery/Context/Compaction composition. This does
# not enable general readiness or provide live-provider acceptance.
GENERAL_AGENT_CHAT_COMPACTION_AUTO_ENABLED=false
# Experimental live ordinary steering; requires original recovery and reviewed Host.
# Includes native final-answer coverage; requires matching Runner and Adapter.
# Historical terminal reconciliation, money and rollout gates remain incomplete.
# Disabling does not clear persisted original-command custody. Drain old execution
# consumers before rollout/rollback; never reset uncertain input into a new run.
# Configure API and owning Worker together; capability reports configuration only.
GENERAL_AGENT_ORDINARY_STEERING_ENABLED=false
# Acceptance-only historical repair requires steering/recovery and Adapter v2
# source-bound history. It never resumes or publishes a final answer. Keep off
# until matching consumer, upgrade/rollback and production gates are accepted.
GENERAL_AGENT_ORDINARY_STEERING_RECONCILIATION_ENABLED=false
# Original terminal-run final publication and frozen channel-receipt follow-up.
# Requires both original recovery and steering above, plus the trusted Host's
# full history reader. Uses existing publisher/outbox; no prompt/model fallback.
# Keep off until consumer upgrade, real-provider and rollout gates are accepted.
# Historical sends wait in a reserved queue state during rollback. Drain older
# producers/consumers before enablement; do not map them to ordinary pending.
GENERAL_AGENT_ORDINARY_FINAL_RECONCILIATION_ENABLED=false

# Experimental original-task attachments; configure API and owning Worker together.
# Requires all original recovery/steering/reconciliation switches above, plus
# matching protocol-4 native admission, claimed-input and history consumers.
# See docs/implementation/2026-10-19-pinned-attachment-sources.md before enabling.
GENERAL_AGENT_ORDINARY_STEERING_ATTACHMENTS_ENABLED=false

# Optional trusted physical Git bindings (owner_id, project_id, absolute root).
# No binding is inferred from browser input. Linked worktrees also require the
# explicit git_directory/common_directory. Keep actual host paths private.
GENERAL_AGENT_GIT_REPOSITORIES=[]
# Optional absolute trusted Git binary; empty uses the operator's absolute PATH.
GENERAL_AGENT_GIT_EXECUTABLE=

# Opt-in native Work compaction metadata; deploy paired updated activity schema/UI.
# Only accepted Work execution policy emits it. Chat maintenance stays private.
GENERAL_AGENT_WORK_COMPACTION_PROJECTION_ENABLED=false
