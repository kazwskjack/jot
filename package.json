{
  "name": "jot-ai-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "demo": "node --env-file-if-exists=.env src/server.mjs --demo",
    "build": "vite build",
    "test": "node --test test/*.test.mjs",
    "test:workbench-ui": "node --test web/workbench/*.test.mjs web/jot/*.test.mjs",
    "test:public": "node --test scripts/verify-public.test.mjs scripts/verify-git-public.test.mjs && node scripts/verify-public.mjs ."
  },
  "dependencies": {
    "fastify": "5.12.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "optionalDependencies": {
    "playwright": "1.63.0"
  }
}
