# Copy to .env and configure a Chat Completions compatible provider.
JOT_PORT=3030
JOT_WORKERS=1
JOT_MAX_STEPS=12
JOT_APPROVAL_TIMEOUT_MS=300000
JOT_MODEL_URL=
JOT_MODEL=
JOT_MODEL_KEY=
# Optional separate Chat route. Defaults off; never silently falls back to Work.
# Enable only for a provider verified to accept thinking:{type:"disabled"}
# and stream_options:{include_usage:true} with streaming tool calls.
JOT_CHAT_ENABLED=false
JOT_CHAT_THINKING_DISABLED_SUPPORTED=false
JOT_CHAT_MODEL_URL=
JOT_CHAT_MODEL=
JOT_CHAT_MODEL_KEY=
# Explicit HTTPS origins only, comma separated. Redirects are not followed.
JOT_WEB_ORIGINS=https://example.com
# Optional JSON search endpoint (q and format=json query parameters).
JOT_SEARCH_URL=
# Optional isolated headless browser. Requires npx playwright install chromium.
JOT_BROWSER=false
# Optional local workbench gateway. Blank disables it with an explicit UI error.
# The public server is a single-owner localhost application, not a multi-user host.
JOT_WORKBENCH_URL=
JOT_WORKBENCH_OWNER=local-user
JOT_WORKBENCH_CSRF_TOKEN=
